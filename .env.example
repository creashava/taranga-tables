# Taranga Tables - Environment Variables Example
# In mock mode, the app runs with zero external credentials.

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key-taranga
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-taranga

# Adapters
PAYMENT_PROVIDER=mock
AGE_PROVIDER=self_declared_stub
NOTIFY_PROVIDER=console
MODERATION_PROVIDER=keyword

# Localization & Timezone
APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# System Mode
MOCK_MODE=true
NEXT_PUBLIC_MOCK_MODE=true
