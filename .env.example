# Taranga Tables - Environment Variables Example
# In mock mode, the app runs with zero external credentials.

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Local Supabase default / Cloud project credentials
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key-taranga
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-taranga

# PostgreSQL connection string for migrations (pnpm db:migrate)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ------------------------------------------------------------------------------
# Adapters & Compliance Settings
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
AGE_PROVIDER=self_declared_stub
NOTIFY_PROVIDER=console
MODERATION_PROVIDER=keyword

# ------------------------------------------------------------------------------
# Cron & Background Jobs
# ------------------------------------------------------------------------------
CRON_SECRET=dev_cron_secret
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Localization & Timezone (IST context for Mysuru)
# ------------------------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# System Mode (Set to false for production once cloud DB & real adapters are connected)
# ------------------------------------------------------------------------------
MOCK_MODE=true
NEXT_PUBLIC_MOCK_MODE=true
